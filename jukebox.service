[Unit]
Description=Rockola Jukebox (FastAPI + mpv)
Documentation=file:///home/saskweise/Rockola-Raspberry/INSTALACION_PI.md
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=saskweise
Group=saskweise
WorkingDirectory=/home/saskweise/Rockola-Raspberry

# Actualiza yt-dlp en cada arranque
ExecStartPre=/home/saskweise/Rockola-Raspberry/venv/bin/python /home/saskweise/Rockola-Raspberry/maintenance.py

ExecStart=/home/saskweise/Rockola-Raspberry/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=5
TimeoutStartSec=120

Environment=PYTHONUNBUFFERED=1
Environment=MPV_HOME=/home/saskweise/.config/mpv
# Crítico: PipeWire del usuario gráfico.
# NO usar %U aquí: en unidades de sistema systemd lo expande a 0 (root) → sin audio.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_RUNTIME_PATH=/run/user/1000/pulse
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
# Pantalla gráfica (XWayland) — mpv --vo=x11 usa esto para la tele
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
# Valores por defecto; rockola.env puede sobrescribir
Environment=ROCKOLA_VIDEO_OUTPUT=HDMI-A-2
Environment=ROCKOLA_X11_SCREEN=1
Environment=ROCKOLA_VIDEO_GEOMETRY=1920x1080+1920+0
EnvironmentFile=-/home/saskweise/Rockola-Raspberry/rockola.env

SupplementaryGroups=gpio video audio render

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
