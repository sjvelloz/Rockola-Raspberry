[Unit]
Description=Rockola Jukebox (FastAPI + mpv)
Documentation=file:///home/saskweise/Rockola-Raspberry/INSTALACION_PI.md
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=saskweise
Group=saskweise
WorkingDirectory=/home/saskweise/Rockola-Raspberry

# Actualiza yt-dlp en cada arranque (sin --quiet raro; el script ya es resiliente)
ExecStartPre=/home/saskweise/Rockola-Raspberry/venv/bin/python /home/saskweise/Rockola-Raspberry/maintenance.py

ExecStart=/home/saskweise/Rockola-Raspberry/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=5
TimeoutStartSec=120

Environment=PYTHONUNBUFFERED=1
Environment=MPV_HOME=/home/saskweise/.config/mpv
# Vídeo fullscreen en la tele (HDMI). Ajusta 0/1 según xrandr / wlr-randr
Environment=ROCKOLA_MPV_FS_SCREEN=1

SupplementaryGroups=gpio video audio render

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
